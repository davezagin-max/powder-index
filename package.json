{
  "name": "powder-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-duckdb.mjs && next dev -p 3140",
    "dev:api": "cd pipeline && uv run uvicorn app.main:app --port 8140",
    "build": "node scripts/copy-duckdb.mjs && next build",
    "start": "next start -p 3140",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pipeline": "cd pipeline && uv run python -m powder run",
    "pipeline:offline": "cd pipeline && uv run python -m powder run --offline",
    "smoke": "cd pipeline && uv run pytest -q tests/test_smoke_live.py",
    "record": "cd pipeline && uv run python scripts/record.py",
    "screenshots": "node scripts/screenshot.mjs",
    "functional": "node scripts/functional.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "apache-arrow": "^17.0.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.24.0"
}
