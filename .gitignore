# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit secrets; only the example is tracked
.env*
!.env.example

# local tooling
.claude/
docs/.video/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (pipeline/)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# pipeline artifacts (the committed snapshot lives in pipeline/data/snapshot)
pipeline/data/raw/
pipeline/data/*.duckdb
pipeline/data/*.duckdb.wal
pipeline/dbt/target/
pipeline/dbt/logs/
pipeline/dbt/dbt_packages/
pipeline/dbt/.user.yml
pipeline/logs/
site/

# DuckDB-WASM engine files, copied from node_modules by scripts/copy-duckdb.mjs
public/duckdb/
